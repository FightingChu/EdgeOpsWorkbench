{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdgeOps benchmark case",
  "type": "object",
  "required": ["id", "title", "domain", "subdomain", "mechanism", "category", "rounds", "constraints", "setup", "verify"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "domain": {"type": "string", "minLength": 1},
    "subdomain": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "category": {"type": "string", "pattern": "^F[0-9]{2} "},
    "rounds": {"type": "integer", "minimum": 1, "maximum": 10},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "setup": {"type": "string", "minLength": 1},
    "public_checks": {"type": "array", "items": {"type": "string"}},
    "verify": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}

